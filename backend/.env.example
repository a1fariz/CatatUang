# Docker Compose reads this file after copying it to .env.
# Native Go commands read process environment only (no automatic .env loading).
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DB_MAX_CONNECTIONS=10
DB_TIMEOUT=3s
SHUTDOWN_TIMEOUT=10s
# Empty by default. Only trust the exact reverse proxy source address.
# TRUSTED_PROXY_CIDRS=172.30.251.2/32

# Replace before use. For Compose, use a long random hexadecimal password.
POSTGRES_USER=catatuang
POSTGRES_DB=catatuang
POSTGRES_PASSWORD=replace_with_random_hex_password
POSTGRES_PORT=5433
API_PORT=8080
DATABASE_URL=postgres://catatuang:replace_with_random_hex_password@127.0.0.1:5433/catatuang?sslmode=disable

# Optional account email. Set ALL mail settings in process environment for
# both API and mail-worker. Generate a random 32-byte key, base64 standard.
# MAIL_OUTBOX_KEY=
# SMTP_ADDR=127.0.0.1:1025
# SMTP_FROM=noreply@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_ALLOW_INSECURE_LOCAL=true
# Insecure mode: development/test numeric loopback sink only, no credentials.
# Production requires STARTTLS with verified certificate, normally port 587.
