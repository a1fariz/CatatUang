# Docker Compose reads this file after copying it to .env.
# Native Go commands read process environment only (no automatic .env loading).
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DB_MAX_CONNECTIONS=10
DB_TIMEOUT=3s
SHUTDOWN_TIMEOUT=10s

# Replace before use. For Compose, use a long random hexadecimal password.
POSTGRES_USER=catatuang
POSTGRES_DB=catatuang
POSTGRES_PASSWORD=replace_with_random_hex_password
POSTGRES_PORT=5433
API_PORT=8080
DATABASE_URL=postgres://catatuang:replace_with_random_hex_password@127.0.0.1:5433/catatuang?sslmode=disable
