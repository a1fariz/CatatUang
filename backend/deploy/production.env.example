# Copy to an ignored .env outside version control. Do not commit real values.
APP_IMAGE=ghcr.io/your-account/catatuang:reviewed-commit
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
MIGRATION_DATABASE_URL=postgres://catatuang_migrator:replace@db.example.com/catatuang?sslmode=verify-full
RUNTIME_DATABASE_URL=postgres://catatuang_runtime:replace@db.example.com/catatuang?sslmode=verify-full
MAIL_DATABASE_URL=postgres://catatuang_mail:replace@db.example.com/catatuang?sslmode=verify-full
DB_TIMEOUT=5s
DB_MAX_CONNECTIONS=10
APP_SUBNET=172.30.251.0/29
PROXY_IP=172.30.251.2
# Optional: enable mail-worker with --profile mail after all settings are set.
MAIL_OUTBOX_KEY=
SMTP_ADDR=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
